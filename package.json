{
  "name": "university-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated personal cloud file gateway bypassing network blocklists via Google Drive proxy streaming",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run start --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [
    "google-drive",
    "file-gateway",
    "proxy",
    "streaming",
    "university-vault"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
